# No credentials are required for the packaged controlled offline example.
AGROSIM_DATA_DIR=var/agrosim
AGROSIM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGROSIM_ALLOWED_HOSTS=localhost,127.0.0.1
AGROSIM_MAX_PENDING=20
AGROSIM_MAX_STORED=500
AGROSIM_MAX_BODY_BYTES=2000000
AGROSIM_JOB_TIMEOUT_SECONDS=300
# Optional operator-controlled directory; power.json is NASA POWER's existing
# wrapper, not a user-supplied request path. No automatic API acquisition.
# AGROSIM_RESOURCES_DIR=/operator/controlled/resources
# Optional shared bearer token, at least 32 characters. Use an actual secret
# supplied outside Git. Required for non-loopback CLI binding; public deployment
# also needs tenant authorization, gateway rate limits, TLS and quotas.
# AGROSIM_API_TOKEN=
